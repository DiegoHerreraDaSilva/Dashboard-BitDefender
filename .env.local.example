# URL de acesso da API GravityZone (Minha Conta > Chaves de API, no console)
GRAVITYZONE_ACCESS_URL=https://cloud.gravityzone.bitdefender.com/api

# Chave de API "tv-mezanino" - NUNCA commitar o valor real
GRAVITYZONE_API_KEY=

# Intervalo (segundos) do reload completo da página na TV
DASHBOARD_REFRESH_SECONDS=60

# TTL (segundos) do cache interno por domínio (frota/incidentes/licenças)
CACHE_TTL_SECONDS=60

# Timeout (ms) por chamada JSON-RPC
REQUEST_TIMEOUT_MS=10000

# Tentativas de retry em caso de HTTP 429 (rate limit)
MAX_RETRIES_429=3

# Máximo de itens exibidos na lista de "últimas detecções"
INCIDENTS_LIST_LIMIT=10

# Limiares (dias) para cor de alerta no tile de licenciamento (validade)
LICENSE_EXPIRY_WARNING_DAYS=30
LICENSE_EXPIRY_CRITICAL_DAYS=7

# Limiares (% de assentos usados) para cor de alerta no tile de licenciamento
LICENSE_USAGE_WARNING_PERCENT=85
LICENSE_USAGE_CRITICAL_PERCENT=95

# Janela (dias) usada para calcular reincidência por máquina
INCIDENTS_RECURRENCE_LOOKBACK_DAYS=45

# Janela (dias) da lista "últimas detecções" (bloco secundário/detalhe)
INCIDENTS_RECENT_DAYS=30

# Quantas máquinas aparecem no bloco de reincidência
INCIDENTS_TOP_RECURRENCE=5

# Habilita a rota /api/debug/[api] para validar payloads reais da API
# (manter "false" em produção)
ENABLE_DEBUG_ROUTE=false
